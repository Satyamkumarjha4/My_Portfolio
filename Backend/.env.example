DATABASE_URL=postgresql://user:password@host:5432/db
PORT=3000
NODE_ENV=development

# Admin auth. Generate the hash with: npm run hash-password -- "<password>"
ADMIN_ID=admin
ADMIN_PASSWORD_HASH=
# At least 32 random chars, e.g. `openssl rand -hex 32`
JWT_SECRET=

# Comma separated browser origins allowed to call the API (no trailing slash)
CORS_ORIGINS=https://your-frontend.vercel.app
# Set to 1 when running behind a reverse proxy (Render, Railway, Vercel...) so rate limiting sees client IPs
TRUST_PROXY=1
